# WebGPU AI Studio - Server Configuration

PORT=3100
NODE_ENV=development

# JWT Secret (CHANGE THIS IN PRODUCTION)
JWT_SECRET=your-super-secret-jwt-key-change-me

# Master dev admin login (username/password path)
DEV_ADMIN_USERNAME=root
DEV_ADMIN_PASSWORD=08506412
DEV_ADMIN_NAME=Root Admin
DEV_ADMIN_EMAIL=__dev_root_admin__@webgpu-ai.studio

# Owner email (receives approval notifications)
OWNER_EMAIL=you@example.com

# SMTP Configuration (for approval emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Approval Settings
AUTO_APPROVE=false
APPROVAL_TOKEN_LENGTH=32
